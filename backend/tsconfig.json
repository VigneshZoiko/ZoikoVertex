{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "express"],
    "baseUrl": "./src",
    "paths": {
      "shared/*": ["shared/*"],
      "services/*": ["services/*"],
      "config/*": ["config/*"],
      "domains/*": ["domains/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/test/**", "src/**/*.test.ts"]
}
