    "seed:governed-prompts": "ts-node scripts/seedGovernedPrompts.ts",
    "seed:sample-governance": "ts-node scripts/seedSampleGovernancePrompts.ts",
    "seed:validation-agents": "ts-node scripts/seedValidationAgents.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.108.2",
    "archiver": "^8.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pino": "10.3.1",
    "pino-pretty": "^13.0.0",
    "resend": "^6.14.0",
    "stripe": "^22.3.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^7.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "eslint": "^10.6.0",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0",
    "ts-node": "^10.9.2",
